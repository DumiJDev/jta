<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.dumijdev</groupId>
    <artifactId>jta-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>JTA - Java Angular Template</name>
    <description>
        Framework fullstack server-side Java: componentes tipados sobre JTE + HTMX,
        experiencia de desenvolvimento estilo Angular sem TypeScript nem cliente JS.
    </description>
    <url>https://github.com/DumiJDev/jta</url>

    <!--
        groupId io.github.dumijdev (nao dev.jta): o Central Publishing Portal
        exige prova de posse do namespace do groupId, e dev.jta exigiria
        provar posse do dominio jta.dev - io.github.<usuario> e verificado
        automaticamente contra a conta GitHub do publisher, sem esse passo.
        Decisao de produto para o release 0.1.0 (ver plano mestre da fase 5).
        Os pacotes Java continuam dev.jta.* de proposito - groupId Maven e
        namespace de pacote Java sao coisas independentes, e renomear todo
        pacote so por causa disso seria um breaking change desnecessario
        nesta fase (config de publicacao, nao reescrita de codigo).
    -->

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/DumiJDev/jta.git</connection>
        <developerConnection>scm:git:https://github.com/DumiJDev/jta.git</developerConnection>
        <url>https://github.com/DumiJDev/jta</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <name>Dumilde Fernando</name>
            <email>dumilde.fernando@selenium.ao</email>
            <url>https://github.com/DumiJDev</url>
        </developer>
    </developers>

    <!--
        Publicacao no Maven Central via Central Publishing Portal
        (central.sonatype.com) - o antigo OSSRH (s01.oss.sonatype.org) foi
        desativado em 30/06/2025, entao central-publishing-maven-plugin
        (nao mais nexus-staging-maven-plugin) e a via atual. Apenas
        scaffolding de config aqui - ver perfil "release" no build abaixo;
        nenhum deploy real foi executado, nenhuma credencial/chave GPG foi
        manuseada.
    -->
    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <modules>
        <module>jta-core</module>
        <module>jta-template-transform</module>
        <module>jta-processor</module>
        <module>jta-runtime</module>
        <module>jta-spring-boot-starter</module>
        <module>jta-javalin-starter</module>
        <module>jta-standalone</module>
        <module>jta-quarkus-extension</module>
        <module>jta-tck</module>
        <module>jta-cli</module>
        <module>jta-test</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jte.version>3.1.16</jte.version>
        <jspecify.version>1.0.0</jspecify.version>
        <spring-boot.version>3.5.16</spring-boot.version>
        <classgraph.version>4.8.176</classgraph.version>
        <jackson.version>2.17.2</jackson.version>
        <toml.version>0.7.3</toml.version>
        <jakarta-validation.version>3.1.0</jakarta-validation.version>
        <junit.version>5.11.0</junit.version>
        <javalin.version>7.2.3</javalin.version>
        <quarkus.version>3.15.1</quarkus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>gg.jte</groupId>
                <artifactId>jte</artifactId>
                <version>${jte.version}</version>
            </dependency>

            <dependency>
                <groupId>io.javalin</groupId>
                <artifactId>javalin</artifactId>
                <version>${javalin.version}</version>
            </dependency>

            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.classgraph</groupId>
                <artifactId>classgraph</artifactId>
                <version>${classgraph.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <dependency>
                <groupId>org.tomlj</groupId>
                <artifactId>tomlj</artifactId>
                <version>${toml.version}</version>
            </dependency>

            <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>${jakarta-validation.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <!--
                            Spring MVC resolve @PathVariable/@RequestParam/@ModelAttribute
                            sem nome explicito via reflection sobre o nome do parametro -
                            que so sobrevive no bytecode com esta flag. Sem ela, qualquer
                            binding sem nome explicito falha em runtime com
                            "parameter name information not available via reflection"
                            (bug real encontrado rodando o jta-demo). Ligado globalmente
                            para nao depender de cada dev lembrar de nomear todo parametro.
                        -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>gg.jte</groupId>
                    <artifactId>jte-maven-plugin</artifactId>
                    <version>${jte.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
        Perfil "release": empacota javadoc+sources e assina com GPG,
        prontos para deploy no Central Publishing Portal. Isolado num
        perfil nao-ativo-por-default (em vez de <build><plugins> direto)
        de proposito - `mvn compile`/`mvn test`/`mvn install` do dia a dia
        NAO devem exigir uma chave GPG configurada nem pagar o custo de
        gerar javadoc de todo modulo a cada build. Ativa com
        `mvn -Prelease deploy` (nao executado neste corte - config-only,
        ver nota da tarefa: nenhuma chave GPG/credencial foi manuseada
        neste ambiente).
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.10.1</version>
                        <configuration>
                            <!--
                                Os comentarios Javadoc deste projeto sao
                                escritos em portugues e usam pontuacao/HTML
                                informal (ver estilo em todo o codebase) -
                                o linter estrito do javadoc do JDK 21 rejeita
                                isso por padrao (tags cruzadas, HTML nao
                                fechado, etc). doclint desligado aqui para o
                                jar de javadoc gerar sem exigir reescrever
                                toda a documentacao existente so por causa
                                do publish - decisao de escopo, nao descuido.
                            -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <failOnError>false</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!--
                            central-publishing-maven-plugin, nao
                            nexus-staging-maven-plugin/o antigo
                            org.sonatype.plugins:nexus-staging-maven-plugin -
                            este ultimo falava com OSSRH (s01.oss.sonatype.org),
                            desativado em 30/06/2025. Todo projeto novo (e
                            todo projeto migrado) publica via este plugin
                            contra o Central Publishing Portal desde entao.
                        -->
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                                autoPublish=false de proposito: sobe para
                                staging no Central Publishing Portal mas exige
                                confirmacao manual antes de ir para o Central
                                de verdade - rede de seguranca para o primeiro
                                release real, nao removida neste corte.
                            -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
