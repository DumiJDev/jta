<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.dumijdev</groupId>
        <artifactId>jta-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jta-test</artifactId>
    <packaging>jar</packaging>
    <name>jta-test</name>
    <description>
        Utilitarios de teste para quem constroi aplicacoes EM CIMA do JTA
        (nao para testar o proprio framework - isso ja e coberto pelos
        testes internos de cada modulo). Instancia um componente isolado,
        popula estado como uma requisicao real faria (respeitando o
        allowlist de bindableFields), invoca acoes/renderiza via
        JtaPageDispatcher/JtaActionDispatcher (o mesmo caminho de codigo
        que roda em producao - nenhuma logica de dispatch e duplicada
        aqui), e oferece asserts prontos sobre PageResult/ActionResult.
        Puramente aditivo: nao muda nada em jta-core/jta-runtime, que ja
        sao agnosticos de framework - ver package-info.java para o
        raciocinio completo e para o que fica de fora deste corte
        (mock de CSRF/sessao).
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.dumijdev</groupId>
            <artifactId>jta-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.dumijdev</groupId>
            <artifactId>jta-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>gg.jte</groupId>
            <artifactId>jte</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <!-- entra como annotation processor nos consumidores, nunca em runtime -
                 aqui so para compilar o fixture usado pelos proprios testes deste modulo. -->
            <groupId>io.github.dumijdev</groupId>
            <artifactId>jta-processor</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!--
                JUnit so em escopo test, nunca exposto a quem depende de
                jta-test: os asserts em JtaAssertions lancam AssertionError
                puro (tipo do proprio JDK), reconhecido por qualquer runner
                (JUnit, TestNG, AssertJ como causa) - jta-test nao deveria
                forcar JUnit especificamente em quem prefere outro runner,
                mesma filosofia de jta-runtime ser agnostico de framework
                web (ver package-info.java).
            -->
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- so para o fixture de teste deste modulo (JtaTestHarnessTest) -
                     um consumidor real ja tem isto configurado na propria app. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.dumijdev</groupId>
                            <artifactId>jta-processor</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>gg.jte</groupId>
                <artifactId>jte-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>precompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sourceDirectory>${project.build.directory}/generated-test-sources/test-annotations/jta-templates</sourceDirectory>
                    <targetDirectory>${project.build.testOutputDirectory}</targetDirectory>
                    <contentType>Html</contentType>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
